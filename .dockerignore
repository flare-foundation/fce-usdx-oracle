# Build context is the repo root, which is the Go module. Everything that is not
# the module's own sources is excluded: anything in the context can perturb layer
# hashes and undermine reproducibility.
.git
.gitignore
.env
.env.*
*.md
docs/
testing/
.superpowers/
.claude/
results/
contracts/
deploy/
tools/
Dockerfile*
.dockerignore
go.work
go.work.sum
# Runtime output of start-services.sh; must not perturb the build context.
out/
