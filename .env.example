# Funded private key for proxy signing (Hardhat dev key)
PROXY_PRIVATE_KEY="983760a4ebf75b2ac3a93531168a0f225d01e5dc6e3568adbd46233ba1fb4fa4"

# # Devnet
# INITIAL_OWNER="0xF4E021377420Afe90c1A7D2b8968904946633a64" # Initial owner address (derived from DEPLOYMENT_PRIVATE_KEY)
# DEPLOYMENT_PRIVATE_KEY="983760a4ebf75b2ac3a93531168a0f225d01e5dc6e3568adbd46233ba1fb4fa4" # Private key for the deployments and contract calls

# Coston
INITIAL_OWNER="0x123.."
DEPLOYMENT_PRIVATE_KEY="123..."

# TEE governance — the signer set + threshold that governs this extension's TEE
# machines. post-build registers it on-chain (set-governance) AND the TEE node
# signs with it; both read these same vars, so they always agree. If unset,
# defaults to GOVERNANCE_SIGNERS=<INITIAL_OWNER> (the deployer) and
# GOVERNANCE_THRESHOLD=1. Set your own to use a different governance set:
# GOVERNANCE_SIGNERS="0xAbc...,0xDef..."   # comma-separated 0x addresses
# GOVERNANCE_THRESHOLD=2

# Docker image registry (defaults to "local" for locally-built images)
# Uncomment to use remote registry:
# REGISTRY=registry.gitlab.com/flarenetwork/tee/e2e

# Chain RPC URL
CHAIN_URL=https://coston2-api.flare.network/ext/C/rpc

# Path to Coston2 deployed contract addresses
ADDRESSES_FILE=./deploy/config/coston2/deployed-addresses.json

# Must be false on live networks
LOCAL_MODE=false

# TEE attestation mode: true = use test code hash/platform (no real TEE hardware)
# Set to false when running on actual GCP Confidential VM with real attestation
SIMULATED_TEE=true

# Normal/FTDC proxy URL on Coston2
NORMAL_PROXY_URL=https://tee-proxy-coston2-1.flare.rocks

# Extension proxy URL (local)
# EXT_PROXY_URL=http://localhost:6674
EXT_PROXY_URL=https://<your-ngrok-url>.ngrok-free.dev

# API key guarding the proxy's POST /direct endpoint.
#
# Required on coston and coston2, where the proxy config sets
# api_key_variable = "DIRECT_API_KEY" and refuses to start without it. Not used
# on the local devnet, whose config sets api_key_optional instead.
#
# Two things go through /direct and the key is what stands in front of both:
#   TEE_ORACLE/SET_SECRET      deposits a credential into the enclave
#   TEE_ORACLE/GET_READINESS   asks a machine to describe itself, signed
#
# A price is not one of them: GET_FEED is raised on-chain through
# requestFeedUpdate() and the extension refuses it over /direct. So a leaked key
# costs availability and credential-provisioning safety, not price integrity.
# Treat it as a real secret regardless: it is the only gate on SET_SECRET.
#
# Generate one with: openssl rand -hex 32
DIRECT_API_KEY=""

# --- Provisioning credentials (deploy/scripts/upload-hex-key.sh, upload-rpc-keys.sh) ---
#
# DO NOT PUT REAL VALUES HERE. They are listed so the names are discoverable and
# so an unattended run can be scripted; a real upload should export them in the
# shell that runs it, or leave them unset and answer the hidden prompt. A .env
# file is read by every tool in this repo and survives the upload by months.
#
# They are environment variables rather than flags because argv is readable by
# any other process on the machine through `ps`, and lands in shell history.
# usdxprov warns if you pass the equivalent flag.
#
# Which admin set authorises which credential is pinned in the build, never read
# from the payload:
#   hex_api_key      backing set,   >= 1 signature   → upload-hex-key.sh
#   every other ref  providers set, >= 2 signatures  → upload-rpc-keys.sh
#
# EXPECTED_CODE_HASH=      # the build you expect, obtained OUT OF BAND, never from
#                          # the machine being checked (tools/cmd/verify-tee)
# PROXY_URL=               # the ONE machine being provisioned; each has its own
#                          # TEE key, so envelopes are per machine
# USDXPROV_API_KEY=        # same value as DIRECT_API_KEY above
# USDXPROV_KEY=            # one admin private key, hex
# USDXPROV_KEYS=           # comma-separated, for the rare case of holding several
# USDXPROV_VALUE=          # the credential, when driving usdxprov by hand
#
# The Hex backing credentials. Give them to the chain switch once
# (HEX_API_KEY=… HEX_CASH_URL=… ./deploy/scripts/use-chain.sh <chain>) and the
# scripts do the rest: use-chain.sh writes them here and carries them across later
# switches, publish-local.sh endpoints commits the hex_cash group to HEX_CASH_URL,
# and upload-hex-key.sh hands the URL and the key to the machine. The machine
# counts the cash figure only once it holds both; until then it runs cash-less.
# The salt binds the published commitment to the provisioned URL and must not
# change between the two; publish-local.sh generates and records it here when
# missing, and use-chain.sh carries it over with the rest.
# HEX_API_KEY=
# HEX_CASH_URL=            # https://…, the restricted cash endpoint
# HEX_CASH_SALT=           # openssl rand -hex 32
#
# One per RPC credential, named after its ref in the endpoints configuration:
# ANKR_FLARE_KEY=
# ALCHEMY_FLARE_KEY=
# ANKR_ETH_KEY=

# --- Docker Compose overrides (all have defaults, uncomment to customize) ---
# SOURCE_DATE_EPOCH=            # Unix timestamp for reproducible builds (auto-derived from git by start-services.sh)
# CHAIN_ID=31337                # Chain id the node binds signatures to (local=31337, coston=16, coston2=114)
# LOG_LEVEL=INFO                # TEE node log level
# MODE=1                        # Attestation backend: 1 simulated (the compose default), 0 production (the image default)
# REDIS_BIND=127.0.0.1:6389    # Host binding for the extension Redis; unset → a free port per run
# EXT_PROXY_INTERNAL_BIND=0.0.0.0:6673  # Host port binding for proxy internal API
# EXT_PROXY_EXTERNAL_BIND=0.0.0.0:6674  # Host port binding for proxy external API
# COMPOSE_NETWORK=docker_default         # Docker network name (base compose joins this external network)
# USE_LOCAL_SIBLINGS=0          # Set to 1 to build node/proxy from on-disk sibling checkouts
# WAIT_TIMEOUT=                 # Timeout for post-build registration waits
# TEE_VERSION=                  # TEE version label for allow-tee-version
