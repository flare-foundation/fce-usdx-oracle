#checkov:skip=CKV_DOCKER_2:HEALTHCHECK not applicable, the node runs behind the stack's proxy
# Local-siblings node build — opt-in via `USE_LOCAL_SIBLINGS=1 ./deploy/scripts/start-services.sh`.
# The .dev suffix keeps this development build out of the CI component's image release; the
# component still lints it with hadolint and checkov, like ./Dockerfile.
# Build context is tee/ (the parent of both tee-node/ and extension-examples/) so the on-disk
# sibling tee-node can be compiled into the node instead of the pinned module version. This file
# is selected through docker-compose.siblings.yaml; the default reproducible, self-contained,
# pinned build lives in ./Dockerfile.

# Pinned by digest so every build starts from the same bytes. The sibling checkouts
# require Go 1.25.8, ahead of the pinned build's 1.25.1. The alpine variant ships the
# CA bundle the final stage copies, so this dev build needs no package installs; the
# reproducible apt snapshot machinery stays with the production build in ./Dockerfile.
FROM golang:1.25.8-alpine@sha256:8e02eb337d9e0ea459e041f1ee5eece41cbb61f1d83e7d883a3e2fb4862063fa AS builder

# commit timestamp, propagated through the build to clamp file mtimes and normalize embedded dates
ARG SOURCE_DATE_EPOCH
ENV SOURCE_DATE_EPOCH=$SOURCE_DATE_EPOCH

WORKDIR /build

# bring in both modules; tee-node sits next to fce-usdx-oracle so the replace directive resolves
# explicit chmod/chown on COPY so file metadata does not depend on host umask or ownership
COPY --chmod=644 --chown=0:0 tee-node/ ./tee-node/
COPY --chmod=644 --chown=0:0 extension-examples/fce-usdx-oracle/ ./extension-examples/fce-usdx-oracle/

# The repo root is the Go module.
WORKDIR /build/extension-examples/fce-usdx-oracle

# The committed go.mod pins tee-node to a released version (see ./Dockerfile); point it at the
# on-disk sibling for this dev build. -mod=mod lets go reconcile go.sum against the sibling's
# dependency tree in-layer without mutating the committed go.sum on the host.
# Path is relative to the module dir: fce-usdx-oracle -> extension-examples -> /build.
RUN go mod edit -replace github.com/flare-foundation/tee-node=../../tee-node

# start-services.sh writes a go.work at the repo root (the module root) for HOST builds, listing both
# sibling checkouts. It travels into the context, and go.work takes precedence over
# the replace above — so the build then demands /build/tee-proxy, which this image
# deliberately does not copy (the proxy is a separate image). Dropped rather than
# satisfied: the explicit replace is what this build resolves tee-node through.
# hadolint ignore=DL3059
RUN rm -f go.work go.work.sum

# Module source for the download. start-services.sh passes the host module cache,
# served for the build's duration, with the public proxy as fallback.
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=$GOPROXY

RUN GOFLAGS=-mod=mod go mod download

# -trimpath strips build-host paths from the binary
# -buildid= clears go's non-deterministic build id
# -s -w drop symbol and dwarf tables, which contain build-time data
# -buildvcs=false omits embedded vcs metadata
# CGO_ENABLED=0 produces a static binary, avoiding link-time libc variance
# hadolint ignore=DL3059
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOFLAGS="-buildvcs=false -mod=mod" \
    go build -trimpath -ldflags="-buildid= -s -w" -o /app/extension-tee ./cmd/extension-tee

# NOTE: buildkit's rewrite-timestamp only clamps mtimes down to SOURCE_DATE_EPOCH (moby/buildkit#3180)
# files older than SOURCE_DATE_EPOCH are left at their original non-deterministic mtime
# touch every path to SOURCE_DATE_EPOCH explicitly so timestamps are normalized in both directions
# hadolint ignore=DL3059
RUN if [ "${SOURCE_DATE_EPOCH:-0}" -gt 0 ] 2>/dev/null; then find /app -exec touch -h -d @${SOURCE_DATE_EPOCH} {} +; fi

# the production build's base, pinned by digest, so nothing outside these explicit copies ends up in the final layers
FROM gcr.io/distroless/static-debian12@sha256:20bc6c0bc4d625a22a8fde3e55f6515709b32055ef8fb9cfbddaa06d1760f838

WORKDIR /app

# ca-certificates.crt is the tls trust store for outbound https (e.g. flare rpc, oauth)
# re-apply chmod/chown on each COPY so metadata is pinned here and does not depend on whatever the builder stage left behind
COPY --chmod=644 --chown=65532:65532 --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --chmod=755 --chown=65532:65532 --from=builder /app/extension-tee /app/extension-tee

# MODE=1 is simulated attestation. This image exists for the local simulation
# only, so unlike the production Dockerfile it defaults to it; compose sets MODE
# explicitly either way.
ENV MODE=1

# match tee-node: run as root (USER 0:0) — the TEE workload itself is the isolation boundary
# hadolint ignore=DL3002
USER 0:0

# same launch policy and exposed ports as the production Dockerfile
LABEL "tee.launch_policy.allow_env_override"="LOG_LEVEL,PROXY_URL,INITIAL_OWNER,EXTENSION_ID,CHAIN_URL,CHAIN_ID,GOVERNANCE_SIGNERS,GOVERNANCE_THRESHOLD,SIGN_PORT,EXTENSION_PORT"

EXPOSE 5500

CMD ["/app/extension-tee"]
