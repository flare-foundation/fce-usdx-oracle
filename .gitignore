.env*
*.env
# The local simulation's environment holds only Hardhat test keys, so it is tracked.
!.env.local
!*.example

# Coston/Coston2 proxy configs (contain DB credentials)
deploy/config/proxy/extension_proxy.coston.toml
deploy/config/proxy/extension_proxy.coston.docker.toml
deploy/config/proxy/extension_proxy.coston2.toml
deploy/config/proxy/extension_proxy.coston2.docker.toml
deploy/config/extension.env
# Written by import-upstream-addresses.sh local from the e2e sim dump; changes per sim run.
deploy/config/local/
# Rendered proxy configs, and in --local mode pids, logs and host binaries.
out/
deploy/config/**/*.log
deploy/config/register-tee.state
.DS_Store

# Foundry build artifacts and dependencies — run `forge install` in contracts/ after cloning.
# Anchored: a bare lib/ would also swallow deploy/scripts/lib/.
contracts/out/
contracts/cache/
contracts/lib/
contracts/broadcast/

# go.work is generated on demand by deploy/scripts/start-services.sh for
# USE_LOCAL_SIBLINGS=1 (points host builds at sibling tee-node / tee-proxy).
go.work
go.work.sum

# Compiled tooling binaries
tools/allow-*
tools/register-*
tools/verify-*
tools/set-*
tools/audit-*
tools/fleet-status
tools/keeper
tools/send-endpoints
tools/send-admins
tools/wire-extension

# Generated contract bindings (produced by deploy/scripts/generate-bindings.sh)
tools/pkg/contracts/*/autogen.go
tools/pkg/contracts/*/*.abi
tools/pkg/contracts/*/*.bin

