# Docker-specific Coston2 proxy config. Service names instead of localhost.
redis_port = "redis:6379"
private_key_variable = "PROXY_PRIVATE_KEY"
initial_signing_policy_offset = 2
signing_policy_fetch_interval = "20s"

chain_id = 114

[db]
host = "<indexer-db-host>"
port = 3306
database = "<indexer-db-name>"
username = "<indexer-db-user>"
password = "<indexer-db-password>"
log_queries = false

[addresses]
flare_systems_manager = "0xA90Db6D10F856799b10ef2A77EBCbF460aC71e52"
relay = "0xa10B672D1c62e5457b17af63d4302add6A99d7dE"
voter_registry = "0x6a0AF07b7972177B176d3D422555cbc98DfDe914"


[ports]
internal = "6663"
external = "6664"

[info_timing]
cycle_internal = "10s"
cycle_queue_response_wait = "2s"

[voting]
proposal_expiration = "12s"
max_pending_request = 10000

# POST /direct carries the two commands that have no on-chain counterpart:
# TEE_ORACLE/SET_SECRET, which deposits a credential into the enclave, and
# TEE_ORACLE/GET_READINESS, which asks the machine to describe itself. A price
# is NOT one of them — GET_FEED is an on-chain instruction and the extension
# refuses it over this endpoint.
#
# The key is mandatory on a reachable proxy. /direct is on the PUBLIC external
# port and SET_SECRET goes through it, so an unauthenticated one is both a way
# to flood the enclave and the only thing standing in front of credential
# provisioning.
[direct]
enable = true
api_key_variable = "DIRECT_API_KEY"
