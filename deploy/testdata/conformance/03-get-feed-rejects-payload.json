{
  "name": "03-get-feed-rejects-payload",
  "description": "requestFeedUpdate() sends exactly the ABI-encoded FeedUpdateRequest. Any other message \u2014 here a JSON blob that is neither 32 bytes nor a valid feed id \u2014 is a handler error, not silently ignored: HTTP 200, status 0, no data.",
  "request": {
    "method": "POST",
    "path": "/action",
    "body": {
      "data": {
        "id": "0x1111111111111111111111111111111111111111111111111111111111111111",
        "type": "instruction",
        "submissionTag": "submit",
        "message": ""
      },
      "additionalVariableMessages": [],
      "timestamps": [],
      "additionalActionData": "0x",
      "signatures": []
    }
  },
  "expect": {
    "status": 200,
    "json_subset": {
      "status": 0,
      "data": "0x"
    },
    "log_prefix": "error: "
  }
}
