# Local end-to-end against the e2e repository's Hardhat simulation.
FLARE_CHAIN=local
# Activate with ./deploy/scripts/use-chain.sh local (or full-setup.sh --chain local).
# Every key here is a public Hardhat test key; nothing in this file is secret.

CHAIN_URL=http://127.0.0.1:8545
CHAIN_ID=31337
LOCAL_MODE=true
SIMULATED_TEE=true

# Written by ./deploy/scripts/deploy-oracle.sh --chain local: the sim's
# contracts from the e2e dump plus the oracle contracts deployed on top of them.
ADDRESSES_FILE=./deploy/config/local/deployed-addresses.json

# This repo's extension proxy (Docker publishes 6674) and the e2e repo's
# standard TEE proxy, which the machine registration verifies through.
NORMAL_PROXY_URL=http://localhost:6662

# The funded simulation key, the extension owner. It deploys the oracle
# contracts (deploy-oracle.sh) and stays their governance, so it publishes
# SET_ENDPOINTS / SET_ADMINS directly; it owns reserved extension 1, owns the TEE
# machine, signs for the proxy and pays for keeper cycles.
EXTENSION_OWNER_KEY=983760a4ebf75b2ac3a93531168a0f225d01e5dc6e3568adbd46233ba1fb4fa4
PROXY_PRIVATE_KEY=983760a4ebf75b2ac3a93531168a0f225d01e5dc6e3568adbd46233ba1fb4fa4
INITIAL_OWNER=0xF4E021377420Afe90c1A7D2b8968904946633a64

# Hardhat account 0 (0xc783df8a850f42e7F7e57013759C285caa701eB6): the
# simulation's contract governance and sole timelock executor. deploy-oracle.sh
# reserves extension 1 for INITIAL_OWNER with it (registerReserved), and
# publish-local.sh records and executes a publication with it when the sender is
# in production mode.
LOCAL_GOVERNANCE_KEY=0xc5e8f61d1ab959b397eecc0a37a6517b8e67a0e7cf1f4bce5591f3ed80199122

# Where the other two repositories live, relative to this one.
UPSTREAM_DIR=../../../fsp/flare-smart-contracts-v2
SIM_DUMP=../../e2e/docker/sim_dump/deployed-addresses.json
